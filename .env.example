# SilentFix Codebase Environment Configuration
# Agentic AI For Everyone | Zero Shell Injection | AWS + ElevenLabs + Gemini + Winget

# Gemini AI Brain (Required for AI Intent Planning, structured outputs)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ElevenLabs Voice Accessibility (Optional, silent 204 fallback when empty)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# AWS Cloud Integration (Optional, CodeBuild pre-test & off-thread audit sync)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
SILENTFIX_CODEBUILD_PROJECT=silentfix-pretest-sandbox
SILENTFIX_S3_BUCKET=silentfix-audit-logs
SILENTFIX_DYNAMODB_TABLE=silentfix_audit_events
SILENTFIX_DDB_TABLE=silentfix_audit_events

# Operational Flags
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=silentfix_state.db
ENABLE_MOCK_WINGET=auto
